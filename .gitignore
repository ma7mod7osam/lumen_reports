node_modules
__pycache__

# The built frontend IS committed, so a bench that cannot run the build
# (Frappe v14 on Node below 18, common on shared benches) still ships the SPA
# page instead of serving a 404. A bench that can build regenerates the same
# files. Rebuild and commit these together on every frontend change.
# Source maps are NOT committed: they double the size and expose the source.
/lumen_reports/public/frontend/**/*.map

# Auto-generated by the frappe-ui vite plugin
/frontend/auto-imports.d.ts
/frontend/components.d.ts
